+use std::io::{self, Write};
+use std::time::Duration;
+
+fn run_lifecycle_probe(cli: &Cli) -> p2pnet_daemon::Result<bool> {
+    if cli.binary_probe {
+        let payload = serde_json::json!({
+            "status": "ok",
+            "protocol_version": 1,
+            "pid": std::process::id(),
+        });
+        println!(
+            "{}",
+            serde_json::to_string(&payload).map_err(|error| {
+                DaemonError::Config(format!("failed to serialize lifecycle probe: {error}"))
+            })?
+        );
+        return Ok(true);
+    }
+
+    if !cli.test_tray_event_source {
+        return Ok(false);
+    }
+
+    let raw_event = cli
+        .test_tray_event
+        .as_deref()
+        .ok_or_else(|| DaemonError::Config("missing tray lifecycle event".to_string()))?;
+    let base_event: serde_json::Value = serde_json::from_str(raw_event).map_err(|error| {
+        DaemonError::Config(format!("invalid --test-tray-event JSON: {error}"))
+    })?;
+    let base_sequence = base_event
+        .as_object()
+        .ok_or_else(|| {
+            DaemonError::Config("--test-tray-event must be a JSON object".to_string())
+        })?
+        .get("sequence")
+        .and_then(serde_json::Value::as_u64)
+        .ok_or_else(|| {
+            DaemonError::Config("--test-tray-event.sequence must be an unsigned integer".to_string())
+        })?;
+
+    let stdout = io::stdout();
+    let mut output = stdout.lock();
+    for index in 0..cli.test_tray_event_count {
+        let sequence = base_sequence.checked_add(index as u64).ok_or_else(|| {
+            DaemonError::Config("tray lifecycle sequence overflow".to_string())
+        })?;
+        let mut event = base_event.clone();
+        event
+            .as_object_mut()
+            .expect("tray event object was validated above")
+            .insert("sequence".to_string(), serde_json::json!(sequence));
+        let envelope = serde_json::json!({
+            "protocol_version": 1,
+            "event": event,
+        });
+        serde_json::to_writer(&mut output, &envelope).map_err(|error| {
+            DaemonError::Config(format!("failed to serialize tray lifecycle event: {error}"))
+        })?;
+        output.write_all(b"\n").map_err(|error| {
+            DaemonError::Config(format!("failed to write tray lifecycle event: {error}"))
+        })?;
+        output.flush().map_err(|error| {
+            DaemonError::Config(format!("failed to flush tray lifecycle event: {error}"))
+        })?;
+        if cli.test_tray_event_delay_ms > 0 && index + 1 < cli.test_tray_event_count {
+            std::thread::sleep(Duration::from_millis(cli.test_tray_event_delay_ms));
+        }
+    }
+    Ok(true)
+}
