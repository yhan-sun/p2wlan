#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR=${P2WLAN_SERVER_ROOT:-/opt/p2wlan-server}
CONFIG_DIR=${P2WLAN_SERVER_CONFIG:-/etc/p2wlan}
DATA_DIR=${P2WLAN_SERVER_DATA:-/var/lib/p2wlan}
RELEASE_DIR="$ROOT_DIR/releases"
CURRENT_LINK="$ROOT_DIR/current"

usage() {
  cat <<'EOF'
p2wlan-server - self-hosted control/relay manager

Usage:
  sudo p2wlan-server init [--role control|relay|all]
  sudo p2wlan-server start [--service control|relay|all]
  sudo p2wlan-server stop [--service control|relay|all]
  sudo p2wlan-server restart [--service control|relay|all]
  sudo p2wlan-server status [--service control|relay|all]
  sudo p2wlan-server verify [--service control|relay|all]
  sudo p2wlan-server check [--service control|relay|all]
  sudo p2wlan-server update --archive FILE [--service control|relay|all]
  sudo p2wlan-server update --version VERSION [--base-url URL]
  sudo p2wlan-server backup [--include-config --age-recipient RECIPIENT]
  sudo p2wlan-server restore --backup DIRECTORY [--age-identity FILE]
  sudo p2wlan-server rollback [--version VERSION]
  sudo p2wlan-server logs [--service control|relay]

The manager never overwrites CONFIG_DIR or DATA_DIR during an update.
Set P2WLAN_SERVER_ROOT, P2WLAN_SERVER_CONFIG, or P2WLAN_SERVER_DATA to use
an isolated staging installation.
EOF
}

die() { echo "p2wlan-server: $*" >&2; exit 1; }
need_root() { [ "$(id -u)" -eq 0 ] || die "this command requires root; run with sudo"; }
service_list() {
  case "${1:-all}" in
    control) printf '%s\n' p2wlan-control.service ;;
    relay) printf '%s\n' p2wlan-relay.service ;;
    all) printf '%s\n' p2wlan-control.service p2wlan-relay.service ;;
    *) die "service must be control, relay, or all" ;;
  esac
}

systemd_available() { command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; }
restart_services() {
  local selected=${1:-all}
  if ! systemd_available; then return 0; fi
  systemctl daemon-reload
  while IFS= read -r unit; do
    if systemctl cat "$unit" >/dev/null 2>&1; then
      systemctl restart "$unit"
    fi
  done < <(service_list "$selected")
}

service_units_exist() {
  local selected=${1:-all}
  local found=0
  while IFS= read -r unit; do
    if systemctl cat "$unit" >/dev/null 2>&1; then
      found=1
    fi
  done < <(service_list "$selected")
  [ "$found" -eq 1 ]
}

start_services() {
  local selected=${1:-all}
  systemd_available || die "systemd is unavailable; start the configured processes manually"
  service_units_exist "$selected" || die "no installed systemd unit matches service=$selected"
  systemctl daemon-reload
  while IFS= read -r unit; do
    if systemctl cat "$unit" >/dev/null 2>&1; then
      systemctl enable --now "$unit"
    fi
  done < <(service_list "$selected")
}

stop_services() {
  local selected=${1:-all}
  systemd_available || die "systemd is unavailable; stop the configured processes manually"
  service_units_exist "$selected" || die "no installed systemd unit matches service=$selected"
  while IFS= read -r unit; do
    if systemctl cat "$unit" >/dev/null 2>&1; then
      systemctl stop "$unit"
    fi
  done < <(service_list "$selected")
}

env_value() {
  local file=$1
  local key=$2
  [ -f "$file" ] || return 0
  awk -F= -v key="$key" '$1 == key { value=$0; sub(/^[^=]*=/, "", value); print value; exit }' "$file"
}

verify_server() {
  local selected=${1:-all}
  [ -L "$CURRENT_LINK" ] || die "current release link is missing: $CURRENT_LINK"
  [ -x "$CURRENT_LINK/p2wlan-control" ] || die "control binary is missing from $CURRENT_LINK"
  [ -x "$CURRENT_LINK/p2wlan-relay" ] || die "relay binary is missing from $CURRENT_LINK"
  case "$selected" in
    control) "$CURRENT_LINK/p2wlan-control" --version ;;
    relay) "$CURRENT_LINK/p2wlan-relay" --version ;;
    all)
      "$CURRENT_LINK/p2wlan-control" --version
      "$CURRENT_LINK/p2wlan-relay" --version
      ;;
    *) die "service must be control, relay, or all" ;;
  esac
  echo "verified current=$CURRENT_LINK"
}

check_server() {
  local selected=${1:-all}
  verify_server "$selected"
  if systemd_available; then
    service_units_exist "$selected" || die "no installed systemd unit matches service=$selected"
    while IFS= read -r unit; do
      if systemctl cat "$unit" >/dev/null 2>&1 && ! systemctl is-active --quiet "$unit"; then
        die "systemd unit is not active: $unit"
      fi
    done < <(service_list "$selected")
  fi

  command -v curl >/dev/null 2>&1 || die "curl is required for service health checks"
  local control_enabled=0 relay_enabled=0
  case "$selected" in
    control) control_enabled=1 ;;
    relay) relay_enabled=1 ;;
    all) control_enabled=1; relay_enabled=1 ;;
  esac
  if systemd_available; then
    systemctl cat p2wlan-control.service >/dev/null 2>&1 || control_enabled=0
    systemctl cat p2wlan-relay.service >/dev/null 2>&1 || relay_enabled=0
  fi
  if [ "$control_enabled" -eq 1 ]; then
    local bind host port
    bind=$(env_value "$CONFIG_DIR/control.env" CONTROL_BIND)
    port=$(env_value "$CONFIG_DIR/control.env" PORT)
    host=127.0.0.1
    port=${port:-18080}
    if [ -n "$bind" ]; then
      host=${bind%:*}; port=${bind##*:}
      case "$host" in ''|0.0.0.0) host=127.0.0.1 ;; '[::]') host='[::1]' ;; esac
    fi
    case "$port" in ''|*[!0-9]*) die "invalid control health port" ;; esac
    curl -fsS --connect-timeout 3 --max-time 10 "http://$host:$port/health" >/dev/null || die "control /health failed"
  fi
  if [ "$relay_enabled" -eq 1 ]; then
    local metrics_bind metrics_host metrics_port
    metrics_bind=$(env_value "$CONFIG_DIR/relay.env" RELAY_METRICS_BIND)
    [ -n "$metrics_bind" ] || die "relay readiness cannot be verified: set RELAY_METRICS_BIND=127.0.0.1:18082"
    metrics_host=${metrics_bind%:*}; metrics_port=${metrics_bind##*:}
    case "$metrics_port" in ''|*[!0-9]*) die "invalid relay metrics port" ;; esac
    case "$metrics_host" in
      127.0.0.1|localhost|'[::1]') ;;
      *) die "relay check requires a loopback RELAY_METRICS_BIND" ;;
    esac
    curl -fsS --connect-timeout 3 --max-time 10 "http://$metrics_host:$metrics_port/readyz" >/dev/null || die "relay /readyz failed: check TLS, revocation feed and credentials"
  fi
  echo "health check passed service=$selected"
}

install_unit() {
  local unit=$1
  local binary=$2
  local env_file=$3
  install -d -m 0755 /etc/systemd/system
  cat > "/etc/systemd/system/$unit" <<EOF
[Unit]
Description=P2WLAN ${binary}
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=p2wlan
Group=p2wlan
EnvironmentFile=-${env_file}
ExecStart=${CURRENT_LINK}/${binary}
WorkingDirectory=${DATA_DIR}
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
ReadWritePaths=${CONFIG_DIR} ${DATA_DIR}
UMask=0077

[Install]
WantedBy=multi-user.target
EOF
}

init_server() {
  local role=${1:-all}
  need_root
  case "$role" in control|relay|all) ;; *) die "role must be control, relay, or all" ;; esac
  install -d -m 0755 "$ROOT_DIR" "$RELEASE_DIR" "$CONFIG_DIR" "$DATA_DIR"
  if ! id p2wlan >/dev/null 2>&1; then
    useradd --system --home-dir "$DATA_DIR" --no-create-home --shell /usr/sbin/nologin p2wlan
  fi
  if [ ! -f "$CONFIG_DIR/control.env" ]; then
    install -m 0600 /dev/null "$CONFIG_DIR/control.env"
    printf '%s\n' "PORT=18080" "CONTROL_BIND=127.0.0.1:18080" "DB_PATH=$DATA_DIR/p2pnet.db" "LOG_UPLOAD_DIR=$DATA_DIR/log-uploads" "JWT_SECRET=$(openssl rand -hex 32)" >> "$CONFIG_DIR/control.env"
  fi
  if [ ! -f "$CONFIG_DIR/relay.env" ]; then
    install -m 0600 /dev/null "$CONFIG_DIR/relay.env"
    printf '%s\n' "# Configure TLS, keyring, audience, region and revocation feed before starting; see docs/guides/self-hosting.md" "RELAY_BIND=:18081" "RELAY_REQUIRE_AUTH=true" "RELAY_METRICS_BIND=127.0.0.1:18082" >> "$CONFIG_DIR/relay.env"
  fi
  chown -R p2wlan:p2wlan "$CONFIG_DIR" "$DATA_DIR"
  case "$role" in
    control) install_unit p2wlan-control.service p2wlan-control "$CONFIG_DIR/control.env" ;;
    relay) install_unit p2wlan-relay.service p2wlan-relay "$CONFIG_DIR/relay.env" ;;
    all)
      install_unit p2wlan-control.service p2wlan-control "$CONFIG_DIR/control.env"
      install_unit p2wlan-relay.service p2wlan-relay "$CONFIG_DIR/relay.env"
      ;;
  esac
  if systemd_available; then systemctl daemon-reload; fi
  echo "initialized role=$role config=$CONFIG_DIR data=$DATA_DIR"
}

archive_install() {
  local archive=$1
  need_root
  [ -f "$archive" ] || die "archive not found: $archive"
  [ -f "$archive.sha256" ] || die "missing checksum: $archive.sha256"
  (cd "$(dirname "$archive")" && sha256sum -c "$(basename "$archive.sha256")")
  install -d -m 0755 "$RELEASE_DIR"
  local version
  version=$(tar -xOf "$archive" BUILD-METADATA.txt 2>/dev/null | awk -F= '/^version=/{print $2; exit}')
  version=${version:-archive-$(date -u +%Y%m%d%H%M%S)}
  case "$version" in
    ''|.|..|*[!A-Za-z0-9._-]*) die "archive contains an invalid release version: $version" ;;
  esac
  if ! tar -tzf "$archive" | awk '
      $0 ~ /^\// || $0 ~ /(^|\/)\.\.($|\/)/ { bad=1 }
      END { exit bad }
    '; then
    die "archive contains an unsafe path"
  fi
  local stage="$RELEASE_DIR/.${version}.tmp"
  rm -rf "$stage"
  install -d -m 0755 "$stage"
  tar -xzf "$archive" -C "$stage" --no-same-owner
  for required in p2wlan-control p2wlan-relay p2wlan-config p2wlan-db p2wlan-server install-server.sh deploy-server.sh; do
    [ -x "$stage/$required" ] || die "archive is missing required member: $required"
  done
  if [ -d "$RELEASE_DIR/$version" ]; then
    if cmp -s "$stage/p2wlan-control" "$RELEASE_DIR/$version/p2wlan-control" &&
      cmp -s "$stage/p2wlan-relay" "$RELEASE_DIR/$version/p2wlan-relay"; then
      rm -rf "$stage"
      ln -sfn "$RELEASE_DIR/$version" "$CURRENT_LINK"
      if [ -x "$RELEASE_DIR/$version/p2wlan-server" ]; then
        install -m 0755 "$RELEASE_DIR/$version/p2wlan-server" /usr/local/bin/p2wlan-server
      fi
      echo "release already installed $version"
      return 0
    fi
    die "release directory already exists with different binary content: $version"
  fi
  mv "$stage" "$RELEASE_DIR/$version"
  ln -sfn "$RELEASE_DIR/$version" "$CURRENT_LINK"
  if [ -x "$RELEASE_DIR/$version/p2wlan-server" ]; then
    install -m 0755 "$RELEASE_DIR/$version/p2wlan-server" /usr/local/bin/p2wlan-server
  fi
  chown -R root:root "$RELEASE_DIR/$version" "$CURRENT_LINK"
  echo "installed $version"
}

status_server() {
  local selected=${1:-all}
  if systemd_available; then
    while IFS= read -r unit; do systemctl --no-pager --full status "$unit" || true; done < <(service_list "$selected")
  else
    echo "systemd unavailable; current=$CURRENT_LINK"
  fi
  if [ -x "$CURRENT_LINK/p2wlan-control" ]; then "$CURRENT_LINK/p2wlan-control" --version || true; fi
  if [ -x "$CURRENT_LINK/p2wlan-relay" ]; then "$CURRENT_LINK/p2wlan-relay" --version || true; fi
}

resolve_db_path() {
  local env_file="$CONFIG_DIR/control.env"
  local raw
  if [ "$#" -gt 0 ]; then env_file=$1; fi
  raw=$(env_value "$env_file" DB_PATH)
  if [ -z "$raw" ]; then raw="$DATA_DIR/p2pnet.db"; fi
  case "$raw" in
    file:*|:memory:) die "DB_PATH must be a filesystem path for backup and restore" ;;
    /*) printf '%s\n' "$raw" ;;
    *) printf '%s/%s\n' "$DATA_DIR" "$raw" ;;
  esac
}

backup_server() {
  need_root
  local include_config=0
  local age_recipient=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --include-config) include_config=1; shift ;;
      --age-recipient)
        [ "$#" -ge 2 ] || die "--age-recipient requires a value"
        age_recipient=$2
        shift 2
        ;;
      *) die "unknown backup option: $1" ;;
    esac
  done
  if [ "$include_config" -eq 1 ]; then
    [ -n "$age_recipient" ] || die "--age-recipient is required with --include-config"
    command -v age >/dev/null 2>&1 || die "age is required for encrypted configuration backups"
  fi
  [ -x "$CURRENT_LINK/p2wlan-db" ] || die "current release has no p2wlan-db snapshot tool; install a complete release bundle"
  local db_path
  db_path=$(resolve_db_path)
  [ -f "$db_path" ] || die "database file not found: $db_path"
  install -d -m 0750 "$DATA_DIR/backups"
  local target
  target=$(mktemp -d "$DATA_DIR/backups/p2wlan-$(date -u +%Y%m%dT%H%M%SZ)-XXXXXX")
  chmod 0700 "$target"
  "$CURRENT_LINK/p2wlan-db" --source "$db_path" --output "$target/database.sqlite" \
    > "$target/database-check.txt"
  sha256sum "$target/database.sqlite" > "$target/database.sqlite.sha256"
  {
    printf '%s\n' "created_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf '%s\n' "database_path=$db_path"
    printf '%s\n' "release=$(basename "$(readlink -f "$CURRENT_LINK")")"
    if [ -f "$CURRENT_LINK/BUILD-METADATA.txt" ]; then
      awk -F= '/^(version|commit|arch)=/{print}' "$CURRENT_LINK/BUILD-METADATA.txt"
    fi
    if [ "$include_config" -eq 1 ]; then
      printf '%s\n' "config_encrypted=true"
    else
      printf '%s\n' "config_encrypted=false"
    fi
  } > "$target/metadata.txt"
  if [ "$include_config" -eq 1 ]; then
    local -a config_files=()
    [ -f "$CONFIG_DIR/control.env" ] && config_files+=(control.env)
    [ -f "$CONFIG_DIR/relay.env" ] && config_files+=(relay.env)
    [ "${#config_files[@]}" -gt 0 ] || die "no service configuration files found"
    tar -C "$CONFIG_DIR" -czf - "${config_files[@]}" |
      age --encrypt --recipient "$age_recipient" --output "$target/config.tar.gz.age"
    sha256sum "$target/config.tar.gz.age" > "$target/config.tar.gz.age.sha256"
  fi
  chmod -R go-rwx "$target"
  echo "$target"
}

restore_server() {
  need_root
  systemd_available || die "restore requires systemd so service state can be preserved"
  local backup=
  local age_identity=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --backup)
        [ "$#" -ge 2 ] || die "--backup requires a directory"
        backup=$2
        shift 2
        ;;
      --age-identity)
        [ "$#" -ge 2 ] || die "--age-identity requires a file"
        age_identity=$2
        shift 2
        ;;
      *) die "unknown restore option: $1" ;;
    esac
  done
  [ -n "$backup" ] || die "restore requires --backup DIRECTORY"
  [ -d "$backup" ] || die "backup directory not found: $backup"
  [ -f "$backup/database.sqlite" ] || die "backup database is missing"
  [ -f "$backup/database.sqlite.sha256" ] || die "backup database checksum is missing"
  [ -f "$backup/metadata.txt" ] || die "backup metadata is missing"
  for metadata_key in created_at database_path release config_encrypted; do
    [ -n "$(env_value "$backup/metadata.txt" "$metadata_key")" ] || die "backup metadata is missing $metadata_key"
  done
  case "$(env_value "$backup/metadata.txt" config_encrypted)" in
    true)
      [ -f "$backup/config.tar.gz.age" ] || die "backup metadata requires encrypted configuration"
      [ -f "$backup/config.tar.gz.age.sha256" ] || die "encrypted configuration checksum is missing"
      (cd "$backup" && sha256sum -c config.tar.gz.age.sha256)
      ;;
    false) [ ! -e "$backup/config.tar.gz.age" ] || die "backup contains encrypted configuration but metadata says false" ;;
    *) die "backup metadata has invalid config_encrypted value" ;;
  esac
  (cd "$backup" && sha256sum -c database.sqlite.sha256)
  [ -x "$CURRENT_LINK/p2wlan-db" ] || die "current release has no p2wlan-db restore verifier"

  local restore_tmp
  restore_tmp=$(mktemp -d /tmp/p2wlan-restore.XXXXXX)
  trap 'rm -rf "$restore_tmp"' EXIT
  "$CURRENT_LINK/p2wlan-db" --verify "$backup/database.sqlite" > "$restore_tmp/restore-check.txt"
  local restore_config="$CONFIG_DIR/control.env"
  if [ -f "$backup/config.tar.gz.age" ]; then
    [ -n "$age_identity" ] || die "backup contains encrypted config; pass --age-identity FILE"
    [ -f "$age_identity" ] || die "age identity not found: $age_identity"
    command -v age >/dev/null 2>&1 || die "age is required to decrypt configuration backups"
    mkdir -p "$restore_tmp/config"
    age --decrypt --identity "$age_identity" --output "$restore_tmp/config.tar.gz" "$backup/config.tar.gz.age"
    if ! tar -tzf "$restore_tmp/config.tar.gz" | awk '
        $0 != "control.env" && $0 != "relay.env" { bad=1 }
        END { exit bad }
      ' || ! tar -tvzf "$restore_tmp/config.tar.gz" | awk '
        $1 !~ /^-/ { bad=1 }
        END { exit bad }
      '; then
      die "encrypted configuration archive must contain only regular control.env or relay.env files"
    fi
    tar --no-same-owner --no-same-permissions -xzf "$restore_tmp/config.tar.gz" -C "$restore_tmp/config"
    [ -f "$restore_tmp/config/control.env" ] && restore_config="$restore_tmp/config/control.env"
  fi

  local db_path
  db_path=$(resolve_db_path "$restore_config")
  install -d -m 0750 "$DATA_DIR/backups"
  local rollback_copy
  rollback_copy=$(mktemp -d "$DATA_DIR/backups/pre-restore-$(date -u +%Y%m%dT%H%M%SZ)-XXXXXX")
  chmod 0700 "$rollback_copy"
  if [ -f "$db_path" ]; then
    "$CURRENT_LINK/p2wlan-db" --source "$db_path" --output "$rollback_copy/database.sqlite" \
      > "$rollback_copy/database-check.txt"
    printf '%s\n' present > "$rollback_copy/database.state"
  else
    printf '%s\n' absent > "$rollback_copy/database.state"
  fi
  if [ -f "$CONFIG_DIR/control.env" ]; then
    cp -p "$CONFIG_DIR/control.env" "$rollback_copy/control.env"
    printf '%s\n' present > "$rollback_copy/control.env.state"
  else
    printf '%s\n' absent > "$rollback_copy/control.env.state"
  fi
  if [ -f "$CONFIG_DIR/relay.env" ]; then
    cp -p "$CONFIG_DIR/relay.env" "$rollback_copy/relay.env"
    printf '%s\n' present > "$rollback_copy/relay.env.state"
  else
    printf '%s\n' absent > "$rollback_copy/relay.env.state"
  fi

  local control_exists=0 relay_exists=0 control_was_active=0 relay_was_active=0
  if systemctl cat p2wlan-control.service >/dev/null 2>&1; then
    control_exists=1
    systemctl is-active --quiet p2wlan-control.service && control_was_active=1
  fi
  if systemctl cat p2wlan-relay.service >/dev/null 2>&1; then
    relay_exists=1
    systemctl is-active --quiet p2wlan-relay.service && relay_was_active=1
  fi

  if [ "$control_was_active" -eq 1 ]; then
    systemctl stop p2wlan-control.service || die "failed to stop control before restore"
    systemctl is-active --quiet p2wlan-control.service && die "control is still active after stop"
  fi
  if [ "$relay_was_active" -eq 1 ]; then
    systemctl stop p2wlan-relay.service || {
      [ "$control_was_active" -eq 0 ] || systemctl start p2wlan-control.service || true
      die "failed to stop relay before restore"
    }
    systemctl is-active --quiet p2wlan-relay.service && {
      [ "$control_was_active" -eq 0 ] || systemctl start p2wlan-control.service || true
      die "relay is still active after stop"
    }
  fi

  local restore_failed=0
  install -m 0600 "$backup/database.sqlite" "$db_path.tmp.$$" || restore_failed=1
  if [ "$restore_failed" -eq 0 ]; then mv -f "$db_path.tmp.$$" "$db_path" || restore_failed=1; fi
  if [ "$restore_failed" -eq 0 ]; then rm -f "$db_path-wal" "$db_path-shm" || restore_failed=1; fi
  if [ "$restore_failed" -eq 0 ] && [ -d "$restore_tmp/config" ]; then
    for config_name in control.env relay.env; do
      if [ -f "$restore_tmp/config/$config_name" ]; then
        install -m 0600 "$restore_tmp/config/$config_name" "$CONFIG_DIR/$config_name" || restore_failed=1
      fi
    done
  fi
  if [ "$restore_failed" -eq 0 ] && id p2wlan >/dev/null 2>&1; then
    chown -R p2wlan:p2wlan "$CONFIG_DIR" "$DATA_DIR" || restore_failed=1
  fi
  if [ "$restore_failed" -eq 0 ] && [ "$control_was_active" -eq 1 ]; then
    systemctl start p2wlan-control.service || restore_failed=1
  fi
  if [ "$restore_failed" -eq 0 ] && [ "$relay_was_active" -eq 1 ]; then
    systemctl start p2wlan-relay.service || restore_failed=1
  fi
  if [ "$restore_failed" -eq 0 ]; then
    if [ "$control_was_active" -eq 1 ] && [ "$relay_was_active" -eq 1 ]; then
      (check_server all) || restore_failed=1
    elif [ "$control_was_active" -eq 1 ]; then
      (check_server control) || restore_failed=1
    elif [ "$relay_was_active" -eq 1 ]; then
      (check_server relay) || restore_failed=1
    fi
  fi

  if [ "$restore_failed" -ne 0 ]; then
    local rollback_failed=0
    set +e
    [ "$control_exists" -eq 0 ] || systemctl stop p2wlan-control.service >/dev/null 2>&1
    [ "$relay_exists" -eq 0 ] || systemctl stop p2wlan-relay.service >/dev/null 2>&1
    if [ "$(cat "$rollback_copy/database.state")" = present ]; then
      install -m 0600 "$rollback_copy/database.sqlite" "$db_path" || rollback_failed=1
    else
      rm -f "$db_path" || rollback_failed=1
    fi
    rm -f "$db_path-wal" "$db_path-shm" || rollback_failed=1
    if [ "$(cat "$rollback_copy/control.env.state")" = present ]; then
      install -m 0600 "$rollback_copy/control.env" "$CONFIG_DIR/control.env" || rollback_failed=1
    else
      rm -f "$CONFIG_DIR/control.env" || rollback_failed=1
    fi
    if [ "$(cat "$rollback_copy/relay.env.state")" = present ]; then
      install -m 0600 "$rollback_copy/relay.env" "$CONFIG_DIR/relay.env" || rollback_failed=1
    else
      rm -f "$CONFIG_DIR/relay.env" || rollback_failed=1
    fi
    if id p2wlan >/dev/null 2>&1; then
      chown -R p2wlan:p2wlan "$CONFIG_DIR" "$DATA_DIR" || rollback_failed=1
    fi
    [ "$control_was_active" -eq 0 ] || systemctl start p2wlan-control.service || rollback_failed=1
    [ "$relay_was_active" -eq 0 ] || systemctl start p2wlan-relay.service || rollback_failed=1
    if [ "$control_was_active" -eq 1 ] && [ "$relay_was_active" -eq 1 ]; then
      (check_server all) || rollback_failed=1
    elif [ "$control_was_active" -eq 1 ]; then
      (check_server control) || rollback_failed=1
    elif [ "$relay_was_active" -eq 1 ]; then
      (check_server relay) || rollback_failed=1
    fi
    set -e
    if [ "$rollback_failed" -ne 0 ]; then
      die "restore failed and rollback could not fully restore the original state; recovery copy=$rollback_copy"
    fi
    die "restore failed; original database, configuration and service state were restored from $rollback_copy"
  fi

  rm -rf "$restore_tmp"
  trap - EXIT
  echo "restored database from $backup; pre-restore copy=$rollback_copy"
}

rollback_server() {
  need_root
  local version=
  if [ "$#" -gt 0 ]; then version=$1; fi
  [ -L "$CURRENT_LINK" ] || die "current release link is missing: $CURRENT_LINK"
  local old_target
  old_target=$(readlink "$CURRENT_LINK")
  local current_version
  current_version=$(basename "$(readlink -f "$CURRENT_LINK")")
  if [ -z "$version" ]; then
    while IFS= read -r candidate; do
      if [ "$candidate" != "$current_version" ]; then version=$candidate; break; fi
    done < <(find "$RELEASE_DIR" -mindepth 1 -maxdepth 1 -type d ! -name '.*.tmp' -printf '%f\n' | sort -V -r)
  fi
  [ -n "$version" ] || die "no previous release is installed"
  [ -d "$RELEASE_DIR/$version" ] || die "release not found: $version"
  for required in p2wlan-control p2wlan-relay p2wlan-config p2wlan-db p2wlan-server install-server.sh deploy-server.sh; do
    [ -x "$RELEASE_DIR/$version/$required" ] || die "rollback target is incomplete: $version (missing $required)"
  done
  "$RELEASE_DIR/$version/p2wlan-control" --version >/dev/null
  "$RELEASE_DIR/$version/p2wlan-relay" --version >/dev/null
  ln -sfn "$RELEASE_DIR/$version" "$CURRENT_LINK"
  if ! restart_services all || ! check_server all; then
    ln -sfn "$old_target" "$CURRENT_LINK"
    restart_services all || true
    die "rollback target failed health verification; restored current=$current_version"
  fi
  echo "rolled back to $version"
}

cmd=${1:-}
shift || true
case "$cmd" in
  -h|--help|help) usage ;;
  init)
    role=all
    [ "${1:-}" = --role ] && role=${2:?missing role}
    init_server "$role"
    ;;
  start)
    selected=all
    while [ "$#" -gt 0 ]; do
      case "$1" in --service) selected=${2:?missing service}; shift 2 ;; *) die "unknown start option: $1" ;; esac
    done
    need_root
    start_services "$selected"
    echo "started service=$selected"
    ;;
  stop)
    selected=all
    while [ "$#" -gt 0 ]; do
      case "$1" in --service) selected=${2:?missing service}; shift 2 ;; *) die "unknown stop option: $1" ;; esac
    done
    need_root
    stop_services "$selected"
    echo "stopped service=$selected"
    ;;
  restart)
    selected=all
    while [ "$#" -gt 0 ]; do
      case "$1" in --service) selected=${2:?missing service}; shift 2 ;; *) die "unknown restart option: $1" ;; esac
    done
    need_root
    restart_services "$selected"
    echo "restarted service=$selected"
    ;;
  status) status_server "${2:-${1:-all}}" ;;
  verify)
    selected=all
    while [ "$#" -gt 0 ]; do
      case "$1" in --service) selected=${2:?missing service}; shift 2 ;; *) die "unknown verify option: $1" ;; esac
    done
    verify_server "$selected"
    ;;
  check)
    selected=all
    while [ "$#" -gt 0 ]; do
      case "$1" in --service) selected=${2:?missing service}; shift 2 ;; *) die "unknown check option: $1" ;; esac
    done
    check_server "$selected"
    ;;
  update)
    archive=
    while [ "$#" -gt 0 ]; do
      case "$1" in --archive) archive=${2:?missing archive}; shift 2 ;; --version) version=${2:?missing version}; shift 2 ;; --service) selected=${2:?missing service}; shift 2 ;; --base-url) base_url=${2:?missing URL}; shift 2 ;; *) die "unknown update option: $1" ;; esac
    done
    if [ -n "${archive:-}" ]; then
      archive_install "$archive"
    elif [ -n "${version:-}" ]; then
      command -v curl >/dev/null 2>&1 || die "curl is required for --version updates"
      arch=$(uname -m)
      case "$arch" in x86_64|amd64) arch=amd64 ;; aarch64|arm64) arch=arm64 ;; *) die "unsupported architecture: $arch" ;; esac
      base_url=${base_url:-https://github.com/yhan-sun/p2wlan/releases/download}
      tmp_dir=$(mktemp -d /tmp/p2wlan-server-update.XXXXXX)
      trap 'rm -rf "$tmp_dir"' EXIT
      archive="$tmp_dir/p2wlan-server-linux-$arch.tar.gz"
      curl -fL --retry 3 -o "$archive" "$base_url/$version/p2wlan-server-linux-$arch.tar.gz"
      curl -fL --retry 3 -o "$archive.sha256" "$base_url/$version/p2wlan-server-linux-$arch.tar.gz.sha256"
      (cd "$tmp_dir" && sha256sum -c "$(basename "$archive.sha256")")
      archive_install "$archive"
    else
      die "update requires --archive FILE or --version server-vX.Y.Z"
    fi
    restart_services "${selected:-all}"
    ;;
  backup) backup_server "$@" ;;
  restore) restore_server "$@" ;;
  rollback)
    rollback_version=
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --version)
          [ "$#" -ge 2 ] || die "--version requires a release"
          rollback_version=$2
          shift 2
          ;;
        *) die "unknown rollback option: $1" ;;
      esac
    done
    if [ -n "$rollback_version" ]; then
      rollback_server "$rollback_version"
    else
      rollback_server
    fi
    ;;
  logs) need_root; journalctl -u "p2wlan-${1:-control}.service" -f ;;
  *) usage >&2; exit 2 ;;
esac
