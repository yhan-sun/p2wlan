# Authenticated TLS relay staging template. Values in angle brackets are
# placeholders and must be supplied by the deployment secret manager.
RELAY_BIND=:443
RELAY_TLS_CERT=/run/secrets/p2wlan/relay/fullchain.pem
RELAY_TLS_KEY=/run/secrets/p2wlan/relay/privkey.pem
RELAY_REQUIRE_AUTH=true
RELAY_ALLOW_LEGACY_UNAUTH=false
RELAY_ALLOW_INSECURE_PLAINTEXT=false
RELAY_TICKET_KEYRING_JSON='{"<control-relay-signer-kid>":"<control-signer-public-key-hex>"}'
RELAY_AUDIENCE=relay-cn-test-1
RELAY_REGION=cn-test
RELAY_REVOCATION_FEED_URL=https://<CONTROL_HOST>/api/v1/relay/revocations
RELAY_REVOCATION_FEED_TOKEN=<independent-relay-revocation-feed-secret>
RELAY_REVOCATION_POLL_INTERVAL=30s

# Diagnostic HTTP is loopback-only. Read it through the SSH tunnel described
# in docs/guides/operations.md; never expose this port through a firewall.
RELAY_METRICS_BIND=127.0.0.1:<METRICS_PORT>
RELAY_METRICS_ALLOW_PUBLIC=false

# Optional UDP observer/STUN port; it is not the encrypted relay data port.
RELAY_UDP_OBSERVER_BIND=:3478
