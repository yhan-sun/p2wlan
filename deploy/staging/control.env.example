# Control-plane staging template. Values in angle brackets are placeholders.
# Load secrets from /run/secrets or an equivalent secret manager; do not put
# private keys, bearer tokens, or Authorization headers in this repository.
CONTROL_PUBLIC_URL=https://<CONTROL_HOST>
JWT_SECRET=<control-jwt-secret-from-secret-manager>
DB_PATH=/var/lib/p2wlan/p2pnet.db
PORT=443

# The daemon-facing catalog must use tls://, never tcp://, in staging or prod.
RELAY_CATALOG_JSON='[{"region":"cn-test","audience":"relay-cn-test-1","endpoint":"tls://relay.example.net:443","udp_observer_endpoint":"relay.example.net:3478"}]'
RELAY_TICKET_SIGNER_KEY_FILE=/run/secrets/p2wlan/relay-ticket-signer.pem
RELAY_TICKET_SIGNER_KID=<control-relay-signer-kid>

# This credential is independent from JWT_SECRET and relay TLS credentials.
RELAY_REVOCATION_FEED_TOKEN=<relay-revocation-feed-secret-from-secret-manager>
